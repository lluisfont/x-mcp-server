# Recommended auth provider: xurl manages OAuth token storage, refresh and rotation.
# First configure xurl outside this project:
# npx -y @xdevplatform/xurl auth apps add fcbnews --client-id <id> --redirect-uri http://localhost:8080/callback
# npx -y @xdevplatform/xurl auth oauth2 --app fcbnews FCBNews2026
X_AUTH_PROVIDER=xurl
X_XURL_APP=fcbnews
X_XURL_USERNAME=FCBNews2026

# Local account label exposed by x_get_active_account.
X_MCP_ACCOUNT=fcbnews2026

# Legacy/fallback auth provider. Use only with X_AUTH_PROVIDER=env.
# Never commit real tokens.
X_USER_ACCESS_TOKEN=

# Multi-account examples. Account names are selected with X_MCP_ACCOUNT.
# X_MCP_ACCOUNT=personal
# X_ACCOUNT_PERSONAL_USER_ACCESS_TOKEN=
# X_ACCOUNT_PERSONAL_REFRESH_TOKEN=
# X_ACCOUNT_WORK_USER_ACCESS_TOKEN=
# X_ACCOUNT_WORK_REFRESH_TOKEN=

# Legacy local OAuth helper. Prefer xurl for new installations.
# Add this redirect URI to the X Developer App:
# http://127.0.0.1:3002/callback
X_OAUTH_CLIENT_ID=
# Optional for confidential apps.
# X_OAUTH_CLIENT_SECRET=
# X_OAUTH_REDIRECT_URI=http://127.0.0.1:3002/callback
# X_OAUTH_SCOPES=tweet.read users.read tweet.write offline.access

# Optional override for testing/proxies. Defaults to https://api.x.com
X_API_BASE_URL=https://api.x.com

# Safety switch: read-only | read-write
X_MCP_MODE=read-only

# Transport for remote MCP hosts such as ChatGPT: stdio | http
X_MCP_TRANSPORT=stdio

# HTTP transport settings. ChatGPT needs this behind a stable HTTPS URL.
X_MCP_HTTP_PORT=3001
X_MCP_HTTP_PATH=/mcp
